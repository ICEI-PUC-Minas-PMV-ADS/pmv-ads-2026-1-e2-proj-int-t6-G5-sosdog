@using System.Security.Claims
@inject SosDog.Models.AppDbContext _context
@{
    SosDog.Models.Usuario usuarioLogado = null;
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var userIdClaim = User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (userIdClaim != null && int.TryParse(userIdClaim, out int idUsuario))
        {
            usuarioLogado = _context.Usuarios.FirstOrDefault(u => u.IdUsuario == idUsuario);
        }
    }
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - SOS Dog</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header class="top-header">
        <div class="logo">
            <a asp-controller="Home" asp-action="Index" class="logo-link">
                <i class="fa-solid fa-paw fa-3x"></i>
            </a>
        </div>

        <nav class="main-nav">
            <a id="btn-mapa" class="nav-btn-transparent" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-location-dot"></i> Mapa dos Casos
            </a>

            <a id="btn-feed" class="nav-btn-transparent" asp-controller="Home" asp-action="Feed">
                <i class="fa-solid fa-folder-open"></i> Feed de Casos
            </a>
        </nav>
        <div class="header-right">
            
            <!-- ====== BARRA DE BUSCA UNIVERSAL ====== -->
            <div class="search-bar" style="background: transparent; padding: 0;">
                <div class="input-group" style="max-width: 300px; background-color: #fff; border-radius: 20px; overflow: hidden; border: 1px solid #ccc;">
                    <input type="text" class="form-control border-0 text-dark" placeholder="Busca..." id="input-busca-global"
                           onkeyup="if(event.key === 'Enter') acionarBusca()">
                    
                    <button class="btn border-0 text-secondary" type="button" onclick="acionarBusca()">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                </div>
            </div>
            <!-- ======================================= -->

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <div class="user-menu-logged">
                    <a href="#" class="user-info text-decoration-none text-white" data-bs-toggle="modal" data-bs-target="#modalPerfil">
                        @if (usuarioLogado != null && !string.IsNullOrEmpty(usuarioLogado.FotoPerfil))
                        {
                            <img src="@usuarioLogado.FotoPerfil" class="rounded-circle border border-1 border-light me-1" width="30" height="30" style="object-fit: cover;" />
                        }
                        else
                        {
                            <i class="fa-solid fa-user-check fs-5"></i>
                        }
                        <span>@User.Identity.Name</span>
                    </a>

                    <form asp-controller="Usuarios" asp-action="Logout" method="post" class="m-0">
                        @Html.AntiForgeryToken()

                        <button type="submit" class="btn btn-sm btn-outline-light rounded-pill">
                            Sair <i class="fa-solid fa-right-from-bracket"></i>
                        </button>
                    </form>
                </div>
            }
            else
            {
                <button type="button" class="btnLogin" data-bs-toggle="modal" data-bs-target="#loginModal">
                    <div class="login-block">
                        <i class="far fa-user-circle"></i>
                        <span>login/cadastrar</span>
                    </div>
                </button>
            }
        </div>
    </header>

    <main>
        @if (TempData["Sucesso"] != null)
        {
            <div class="alert alert-success text-center m-3">@TempData["Sucesso"]</div>
        }
        @if (TempData["ErroLogin"] != null)
        {
            <div class="alert alert-danger text-center m-3">@TempData["ErroLogin"]</div>
        }
        @if (TempData["ErroCadastro"] != null)
        {
            <div class="alert alert-danger text-center m-3">@TempData["ErroCadastro"]</div>
        }
        @if (TempData["ErroReset"] != null)
        {
            <div class="alert alert-danger text-center m-3">@TempData["ErroReset"]</div>
        }
        @if (TempData["SucessoReset"] != null)
        {
            <div class="alert alert-success text-center m-3">@TempData["SucessoReset"]</div>
        }

        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container text-center">
            &copy; 2026 - SOS Dog - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <partial name="~/Views/Usuarios/_LoginModal.cshtml" />
    <partial name="~/Views/Usuarios/_RegistroModal.cshtml" model="new SosDog.Models.Usuario()" />
    <partial name="~/Views/Usuarios/_EsqueciSenhaModal.cshtml" />
    <partial name="~/Views/Usuarios/_RedefinirSenhaModais.cshtml" />
    <partial name="~/Views/Ocorrencias/_CriarOcorrenciaModal.cshtml" model="new SosDog.Models.Ocorrencia()" />

    @if (User.Identity.IsAuthenticated && usuarioLogado != null)
    {
        <partial name="~/Views/Usuarios/_PerfilModais.cshtml" model="usuarioLogado" />
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

    <script src="~/js/usuario.js" asp-append-version="true"></script>
    <script src="~/js/feedCasos.js" asp-append-version="true"></script>

    <!-- SCRIPT UNIVERSAL DA BUSCA -->
    <script>
        function acionarBusca() {
            const input = document.getElementById('input-busca-global');
            if (!input) return;
            
            const termo = input.value.trim();
            
            if (typeof realizarBuscaGlobal === 'function') {
                realizarBuscaGlobal(termo); 
            } 
            else if (termo !== "") {
                window.location.href = `/?busca=${encodeURIComponent(termo)}`;
            }
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>