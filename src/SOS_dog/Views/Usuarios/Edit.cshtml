@model SosDog.Models.Usuario

@{
    ViewData["Title"] = "Editar Perfil";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4 p-4 mx-auto" style="max-width: 650px;">
        <h2 class="fw-bold text-center mb-4">Editar Perfil</h2>

        <form asp-controller="Usuarios" asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="text-center mb-4">
                @if (!string.IsNullOrEmpty(Model.FotoPerfil))
                {
                    <img src="@Model.FotoPerfil" class="rounded-circle mb-3" width="120" height="120" style="object-fit: cover;" />
                }
                else
                {
                    <i class="fa-solid fa-circle-user fa-6x text-muted mb-3"></i>
                }
            </div>

            <div class="mb-3">
                <label asp-for="Nome" class="form-label fw-bold">Nome</label>
                <input asp-for="Nome" class="form-control rounded-pill" required />
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-bold">E-mail</label>
                <input asp-for="Email" type="email" class="form-control rounded-pill" required />
            </div>

            <div class="mb-3">
                <label asp-for="Telefone" class="form-label fw-bold">Telefone</label>
                <input asp-for="Telefone" class="form-control rounded-pill" required />
            </div>

            <div class="mb-4">
                <label for="NovaFoto" class="form-label fw-bold">Nova Foto</label>
                <input type="file" id="NovaFoto" name="NovaFoto" class="form-control" accept="image/*" />
            </div>

            <div class="d-flex justify-content-center gap-3">
                <button type="submit" class="btn btn-warning rounded-pill px-4">
                    Salvar Alterações
                </button>

                <a asp-action="Perfil" class="btn btn-secondary rounded-pill px-4">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>