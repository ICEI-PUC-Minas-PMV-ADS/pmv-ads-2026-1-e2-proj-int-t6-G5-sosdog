@model SosDog.Models.Usuario

@{
    ViewData["Title"] = "Meu Perfil";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4 p-4 mx-auto" style="max-width: 650px;">

        <div class="text-center">
            @if (!string.IsNullOrEmpty(Model.FotoPerfil))
            {
                <img src="@Model.FotoPerfil" class="rounded-circle mb-3" width="130" height="130" style="object-fit: cover;" />
            }
            else
            {
                <i class="fa-solid fa-circle-user fa-6x text-muted mb-3"></i>
            }

            <h2 class="fw-bold mb-1">@Model.Nome</h2>
            <p class="text-muted mb-4">@Model.Email</p>
        </div>

        <hr />

        <div class="mt-4">
            <h5 class="fw-bold mb-3">Dados da conta</h5>

            <div class="mb-3">
                <strong>Nome:</strong>
                <span>@Model.Nome</span>
            </div>

            <div class="mb-3">
                <strong>E-mail:</strong>
                <span>@Model.Email</span>
            </div>

            <div class="mb-3">
                <strong>Telefone:</strong>
                <span>@Model.Telefone</span>
            </div>

            <div class="mb-3">
                <strong>E-mail confirmado:</strong>
                @if (Model.EmailConfirmado)
                {
                    <span class="badge bg-success">Sim</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">Não</span>
                }
            </div>
        </div>

        <div class="mt-4 d-flex justify-content-center gap-3">

            <a asp-controller="Usuarios"
                   asp-action="Edit"
                   class="btn btn-warning rounded-pill px-4">
                <i class="fa-solid fa-pen me-1"></i> Editar
            </a>

            <a asp-controller="Usuarios"
                   asp-action="Delete"
                   class="btn btn-danger rounded-pill px-4">
                <i class="fa-solid fa-trash me-1"></i> Excluir Conta
            </a>

        </div>

    </div>
</div>