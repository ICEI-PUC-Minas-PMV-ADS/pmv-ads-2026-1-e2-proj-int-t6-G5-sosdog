@{
    ViewData["Title"] = "Entrar na sua conta";
    ViewData["EsconderMenu"] = true;
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <h2 class="fw-bold" style="color: #355E54;">🐾 Entrar</h2>
                        <p class="text-muted">Bem-vindo de volta ao SOS DOG!</p>
                    </div>

                    <form asp-controller="Usuarios" asp-action="Login" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold">E-mail</label>
                            <input name="email" type="email" class="form-control form-control-lg rounded-pill" placeholder="exemplo@email.com" required />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Senha</label>
                            <input name="senha" type="password" class="form-control form-control-lg rounded-pill" placeholder="Sua senha" required />
                        </div>
                        
                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-lg rounded-pill fw-bold text-white shadow-sm" style="background-color: #355E54; border: none;">Entrar</button>
                        </div>
                        
                        <div class="text-center mt-4">
                            <p class="mb-1 text-muted small">Ainda não tem uma conta?</p>
                            <a asp-controller="Usuarios" asp-action="Cadastrar" class="text-decoration-none fw-bold" style="color: #D9886A;">Criar nova conta 🐾</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>