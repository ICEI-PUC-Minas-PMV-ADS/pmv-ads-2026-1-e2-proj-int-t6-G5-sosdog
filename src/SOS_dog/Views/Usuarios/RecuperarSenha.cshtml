@{
    ViewData["Title"] = "Recuperar Senha";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            
            <div class="card shadow border-0 rounded-4" style="background-color: #ffffff;">
                <div class="card-body p-5 text-center">
                    
                    <div class="mb-3">
                        <span style="font-size: 3.5rem; color: #1a3c34;">🔒</span>
                    </div>
                    
                    <h3 class="fw-bold mb-3" style="color: #1a1a1a;">ESQUECEU A SENHA ?</h3>
                    
                    <p class="text-muted mb-5 px-md-4" style="font-size: 0.95rem;">
                        Não se preocupe! Insira o e-mail associado à sua conta e enviaremos um link seguro para a redefinir.
                    </p>

                    <form>
                        <div class="text-start mb-4">
                            <label class="fw-bold mb-2">Endereço de e-mail !</label>
                            
                            <div class="input-group input-group-lg border rounded-3 overflow-hidden" style="background-color: #EFEFEF;">
                                <span class="input-group-text border-0 text-muted" style="background-color: transparent;">✉️</span>
                                <input type="email" class="form-control border-0 fw-bold text-muted" style="background-color: transparent;" placeholder="exemplo@gmail.com" required>
                            </div>
                        </div>

                        <div class="d-flex justify-content-center mb-4">
                            <button type="button" class="btn text-white fw-bold px-5 py-2" style="background-color: #355E54; border-radius: 8px;">
                                Enviar um link de recuperação
                            </button>
                        </div>
                    </form>

                    <a asp-controller="Usuarios" asp-action="Login" class="text-danger text-decoration-none fw-bold" style="font-size: 0.9rem;">
                        ⬅ Voltar ao Login
                    </a>
                    
                </div>
            </div>

        </div>
    </div>
</div>