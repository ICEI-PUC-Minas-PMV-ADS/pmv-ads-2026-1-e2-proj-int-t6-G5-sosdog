@model SosDog.Models.Usuario

<div class="modal fade" id="modalPerfil" tabindex="-1" aria-labelledby="modalPerfilLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 600px;">
        <div class="modal-content border-0 rounded-4 shadow-lg">

            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="modalPerfilLabel">Meu Perfil</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <div class="text-center">
                    @if (Model != null && !string.IsNullOrEmpty(Model.FotoPerfil))
                    {
                        <img src="@Model.FotoPerfil" class="rounded-circle mb-3" width="130" height="130" style="object-fit: cover;" />
                    }
                    else
                    {
                        <i class="fa-solid fa-circle-user fa-6x text-muted mb-3"></i>
                    }

                    <h2 class="fw-bold mb-1">@Model?.Nome</h2>
                    <p class="text-muted mb-4">@Model?.Email</p>
                </div>

                <hr />

                <div class="mt-4">
                    <h5 class="fw-bold mb-3">Dados da conta</h5>

                    <div class="mb-3">
                        <strong>Nome:</strong>
                        <span>@Model?.Nome</span>
                    </div>

                    <div class="mb-3">
                        <strong>E-mail:</strong>
                        <span>@Model?.Email</span>
                    </div>

                    <div class="mb-3">
                        <strong>Telefone:</strong>
                        <span>@Model?.Telefone</span>
                    </div>

                    <div class="mb-3">
                        <strong>E-mail confirmado:</strong>
                        @if (Model != null && Model.EmailConfirmado)
                        {
                            <span class="badge bg-success">Sim</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Não</span>
                        }
                    </div>
                </div>
            </div>

            <div class="modal-footer border-0 pt-0 d-flex justify-content-center gap-3">
                <button type="button" class="btn btn-warning rounded-pill px-4 fw-bold" data-bs-toggle="modal" data-bs-target="#modalEditarPerfil">
                    <i class="fa-solid fa-pen me-1"></i> Editar
                </button>

                <a asp-controller="Usuarios" asp-action="Delete" class="btn btn-danger rounded-pill px-4 fw-bold">
                    <i class="fa-solid fa-trash me-1"></i> Excluir Conta
                </a>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="modalEditarPerfil" tabindex="-1" aria-labelledby="modalEditarPerfilLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 600px;">
        <div class="modal-content border-0 rounded-4 shadow-lg">

            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="modalEditarPerfilLabel">Editar Perfil</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-controller="Usuarios" asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="modal-body p-4">
                    <div class="text-center mb-4">
                        @if (Model != null && !string.IsNullOrEmpty(Model.FotoPerfil))
                        {
                            <img src="@Model.FotoPerfil" class="rounded-circle mb-3 shadow-sm" width="120" height="120" style="object-fit: cover;" />
                        }
                        else
                        {
                            <i class="fa-solid fa-circle-user fa-6x text-muted mb-3"></i>
                        }
                    </div>

                    <input type="hidden" asp-for="IdUsuario" />

                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label fw-bold">Nome</label>
                        <input asp-for="Nome" class="form-control rounded-pill" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold">E-mail</label>
                        <input asp-for="Email" type="email" class="form-control rounded-pill" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Telefone" class="form-label fw-bold">Telefone</label>
                        <input asp-for="Telefone" class="form-control rounded-pill" required />
                    </div>

                    <div class="mb-4">
                        <label for="NovaFoto" class="form-label fw-bold">Nova Foto</label>
                        <input type="file" id="NovaFoto" name="NovaFoto" class="form-control" accept="image/*" />
                    </div>
                </div>

                <div class="modal-footer border-0 pt-0 d-flex justify-content-center gap-3">
                    <button type="submit" class="btn btn-warning rounded-pill px-4 fw-bold">
                        Salvar Alterações
                    </button>
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#modalPerfil">
                        Cancelar
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>