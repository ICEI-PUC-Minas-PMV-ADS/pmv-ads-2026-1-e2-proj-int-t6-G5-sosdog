@model IEnumerable<SosDog.Models.Ocorrencia>
@using System.Security.Claims
@{
    ViewData["Title"] = "Dashboard de Ocorrências";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="stylesheet" href="~/css/filtro-mapa.css" asp-append-version="true" />

@* <style>
    .favoritar-btn {
        cursor: pointer;
        transition: transform 0.2s ease;
        color: #6c757d;
        font-size: 1.2rem;
    }

        .favoritar-btn:hover {
            transform: scale(1.2);
        }

        .favoritar-btn.favoritado {
            color: #e63946 !important;
        }
</style> *@

<main class="dashboard-container">
    <aside class="left-sidebar">

        <div class="sidebar-top-bar" id="sidebar-top-bar">

            <span class="cases-count" id="filtro-contador-sidebar"></span>

            <button id="btn-filtrar-favoritos"
                    class="btn-favoritos-toggle"
                    title="Ver apenas favoritos"
                    onclick="toggleFiltroFavoritos()">

                <i class="fa-solid fa-heart"></i>

                <span>Favoritos</span>

            </button>

        </div>

        <div class="cases-list">
            @if (Model != null && Model.Any())
            {
                // 2. LÓGICA DO CORAÇÃO VERMELHO RESTAURADA
                var listafavoritosIds = ViewBag.FavoritosIds as List<int> ?? new List<int>();

                foreach (var item in Model)
                {
                    bool estaFavoritado = listafavoritosIds.Contains(item.IdOcorrencia);

                    <div class="case-card"
                         id="card-ocorrencia-@item.IdOcorrencia"
                         data-favoritado="@(estaFavoritado ? "true" : "false")"
                         data-tipo="@item.TipoOcorrencia"
                         data-id="@item.IdOcorrencia"
                         data-foto="@item.FotoAnimal"
                         data-lat="@item.Latitude"
                         data-lng="@item.Longitude"
                         data-codigo="@item.CodigoCachorro"
                         data-sexo="@item.Sexo"
                         data-cor="@item.CorPelagem"
                         data-porte="@item.Porte"
                         data-estadoSaude="@item.EstadoSaude"
                         data-endereco="@item.Endereco"
                         data-idade="@item.FaixaEtaria"
                         data-usuario="@item.IdUsuario"
                         data-agua="@(item.DataUltimaAgua.HasValue ? item.DataUltimaAgua.Value.ToString("dd/MM HH:mm") : "--:--")"
                         data-comida="@(item.DataUltimaComida.HasValue ? item.DataUltimaComida.Value.ToString("dd/MM HH:mm") : "--:--")"
                         data-ultimo-user="@(string.IsNullOrEmpty(item.NomeUsuarioUltimaAcao) ? "Nenhum registro" : item.NomeUsuarioUltimaAcao)">

                        @if (!string.IsNullOrEmpty(item.FotoAnimal))
                        {
                            <img src="@item.FotoAnimal" class="dog-api-img" alt="Foto do Animal">
                        }
                        else
                        {
                            <img src="~/images/sem-foto.jpg" class="dog-api-img" alt="Sem foto cadastrada">
                        }

                        <div class="case-details">
                            <div class="case-header d-flex justify-content-between align-items-center">
                                <div>
                                    <span>Id: @item.CodigoCachorro</span>
                                    @* <span class="badge badge-green">@item.EstadoSaude</span> *@
                                </div>
                                <i class="fa-solid fa-heart favoritar-btn  @(estaFavoritado ? "favoritado" : "")"
                                   id="coracao-@item.IdOcorrencia"
                                   onclick="alternarFavorito(event, @item.IdOcorrencia)"
                                   title="Favoritar"></i>
                            </div>

                            <p>
                                <strong>Tipo:</strong>
                                @(item.TipoOcorrencia == "Rua" ? "Animal na Rua" : "Meu Pet Sumiu")
                            </p>

                            <p class="text-truncate" title="@item.Descricao">
                                @* <strong>Status:</strong> @item.EstadoSaude - @item.Porte - @item.Sexo *@
                                 <span class="badge badge-green">@item.EstadoSaude</span> 
                            </p>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="p-4 text-center text-muted">
                    <i class="fa-solid fa-dog fa-2x mb-2"></i>
                    <p>Nenhuma ocorrência encontrada no sistema.</p>
                </div>
            }
        </div>

        <div class="sidebar-buttons" style="display: flex; gap: 10px; width: 100%;">
            <a asp-controller="Home" asp-action="Emergencia" style="text-decoration: none; flex: 1; display: block;">
                <button class="btn-orange" style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; gap: 8px; margin: 0;">
                    Urgente <i class="fa-solid fa-triangle-exclamation"></i>
                </button>
            </a>

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <button type="button" class="btn-orange" data-bs-toggle="modal" data-bs-target="#modalOcorrencia" style="flex: 1;">
                    Reportar Animal <i class="fa-solid fa-pen-to-square"></i>
                </button>
            }
            else
            {
                <button type="button" class="btn-orange" data-bs-toggle="modal" data-bs-target="#loginModal" style="flex: 1;">
                    Reportar Animal <i class="fa-solid fa-pen-to-square"></i>
                </button>
            }
        </div>
    </aside>

    <section class="main-map-area">
        @* FILTRO FLUTUANTE NO MAPA (FEITO PELA EQUIPE) *@
        <div class="filtro-mapa-wrapper">
            <button class="btn-filtro-toggle" id="btn-filtro-toggle" onclick="toggleFiltroDropdown()">
                <i class="fa-solid fa-filter"></i>
                Filtrar
                <span class="filtro-badge" id="filtro-badge" style="display:none;">0</span>
                <i class="fa-solid fa-chevron-down filtro-chevron" id="filtro-chevron"></i>
            </button>

            <div class="filtro-mapa-painel" id="filtro-mapa-painel">
                <div class="filtro-mapa-header">
                    <span class="filtro-mapa-titulo">Filtros</span>
                    <span id="filtro-contador" class="filtro-contador">@(Model?.Count() ?? 0) resultados</span>
                </div>
                <div class="filtro-grid">
                    <div class="filtro-campo">
                        <label class="filtro-label">Tipo</label>
                        <select class="filtro-select" id="filtro-tipo"
                                onchange="window.sosDogMap?.setFiltro('tipo', this.value); atualizarBadge()">
                            <option value="">Todos</option>
                            @foreach (var tipo in (Model ?? Enumerable.Empty<SosDog.Models.Ocorrencia>())
                                .Where(o => !string.IsNullOrEmpty(o.TipoOcorrencia))
                                .Select(o => o.TipoOcorrencia).Distinct().OrderBy(t => t))
                            {
                                <option value="@tipo.ToLower()">@tipo</option>
                            }
                        </select>
                    </div>
                    <div class="filtro-campo">
                        <label class="filtro-label">Saúde</label>
                        <select class="filtro-select" id="filtro-estadosaude"
                                onchange="window.sosDogMap?.setFiltro('estadoSaude', this.value); atualizarBadge()">
                            <option value="">Todos</option>
                            @foreach (var estado in (Model ?? Enumerable.Empty<SosDog.Models.Ocorrencia>())
                                .Where(o => !string.IsNullOrEmpty(o.EstadoSaude))
                                .Select(o => o.EstadoSaude).Distinct().OrderBy(e => e))
                            {
                                <option value="@estado.ToLower()">@estado</option>
                            }
                        </select>
                    </div>
                    <div class="filtro-campo">
                        <label class="filtro-label">Porte</label>
                        <select class="filtro-select" id="filtro-porte"
                                onchange="window.sosDogMap?.setFiltro('porte', this.value); atualizarBadge()">
                            <option value="">Todos</option>
                            @foreach (var porte in (Model ?? Enumerable.Empty<SosDog.Models.Ocorrencia>())
                                .Where(o => !string.IsNullOrEmpty(o.Porte))
                                .Select(o => o.Porte).Distinct().OrderBy(p => p))
                            {
                                <option value="@porte.ToLower()">@porte</option>
                            }
                        </select>
                    </div>
                    <div class="filtro-campo">
                        <label class="filtro-label">Sexo</label>
                        <select class="filtro-select" id="filtro-sexo"
                                onchange="window.sosDogMap?.setFiltro('sexo', this.value); atualizarBadge()">
                            <option value="">Todos</option>
                            @foreach (var sexo in (Model ?? Enumerable.Empty<SosDog.Models.Ocorrencia>())
                                .Where(o => !string.IsNullOrEmpty(o.Sexo))
                                .Select(o => o.Sexo).Distinct().OrderBy(s => s))
                            {
                                <option value="@sexo.ToLower()">@sexo</option>
                            }
                        </select>
                    </div>
                    <div class="filtro-campo">
                        <label class="filtro-label">Idade</label>
                        <select class="filtro-select" id="filtro-faixaetaria"
                                onchange="window.sosDogMap?.setFiltro('faixaEtaria', this.value); atualizarBadge()">
                            <option value="">Todas</option>
                            @foreach (var idade in (Model ?? Enumerable.Empty<SosDog.Models.Ocorrencia>())
                                .Where(o => !string.IsNullOrEmpty(o.FaixaEtaria))
                                .Select(o => o.FaixaEtaria).Distinct().OrderBy(i => i))
                            {
                                <option value="@idade.ToLower()">@idade</option>
                            }
                        </select>
                    </div>
                    <div class="filtro-campo filtro-campo-limpar">
                        <button class="btn-limpar-filtros"
                                onclick="window.sosDogMap?.limparFiltros(); atualizarBadge()">
                            <i class="fa-solid fa-xmark"></i> Limpar
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div id="map">
            <button onclick="window.sosDogMap.ativarModoCriacao()"
                    class="btn-reportar-flutuante shadow-lg @(User.Identity != null && User.Identity.IsAuthenticated ? "" : "auth-required")">
                <i class="fa-solid fa-location-dot fa-bounce"></i> Reportar Animal
            </button>

            <button onclick="window.sosDogMap.recentrarNoUsuario()"
                    class="btn-recentrar-flutuante shadow-lg"
                    title="Minha Localização">
                <i class="fa-solid fa-crosshairs"></i>
            </button>
        </div>
    </section>

    <section id="section-feed" class="container-fluid py-4 d-none">
        <div class="feed-wrapper row g-4">
            <div class="col-12 col-md-8 carousel-section">
                <div id="dogCarousel" class="carousel slide shadow-lg rounded-4 bg-white p-4" data-bs-ride="carousel">
                    <div class="carousel-inner pb-4">
                        @{
                            var isFirst = true;
                        }
                        @foreach (var item in Model)
                        {
                            <div class="carousel-item @(isFirst ? "active" : "")">
                                <div class="mx-auto shadow-lg animal-card"
                                     style="max-width: 400px; cursor: pointer;"
                                     data-id="@item.IdOcorrencia"
                                     data-tipo="@item.TipoOcorrencia"
                                     data-foto="@item.FotoAnimal"
                                     data-lat="@item.Latitude"
                                     data-lng="@item.Longitude"
                                     data-codigo="@item.CodigoCachorro"
                                     data-sexo="@item.Sexo"
                                     data-cor="@item.CorPelagem"
                                     data-porte="@item.Porte"
                                     data-estadoSaude="@item.EstadoSaude"
                                     data-idade="@item.FaixaEtaria"
                                     data-usuario="@item.IdUsuario"
                                     data-agua="@(item.DataUltimaAgua.HasValue ? item.DataUltimaAgua.Value.ToString("dd/MM HH:mm") : "--:--")"
                                     data-comida="@(item.DataUltimaComida.HasValue ? item.DataUltimaComida.Value.ToString("dd/MM HH:mm") : "--:--")"
                                     data-ultimo-user="@(string.IsNullOrEmpty(item.NomeUsuarioUltimaAcao) ? "Nenhum registro" : item.NomeUsuarioUltimaAcao)">

                                    <div class="animal-card-img-wrapper">
                                        <img src="@(string.IsNullOrEmpty(item.FotoAnimal) ? "/images/placeholder-dog.png" : item.FotoAnimal)"
                                             class="animal-card-img" alt="Foto do animal" />
                                        <div class="distance-badge shadow-sm">
                                            <i class="fa-solid fa-location-dot"></i> 15 Km
                                        </div>
                                        <div class="animal-card-overlay text-start">
                                            <h3 class="mb-1 fw-bold text-white">@item.Sexo - @item.Porte</h3>
                                            <p class="mb-0 text-light" style="font-size: 0.9rem;">
                                                <i class="fa-solid fa-map-pin text-danger"></i> @item.Endereco
                                            </p>
                                        </div>
                                    </div>

                                    <div class="p-4 text-start bg-white">
                                        <h6 class="fw-bold text-secondary mb-2" style="font-size: 0.85rem; letter-spacing: 1px;">SOBRE</h6>
                                        <p class="text-muted small mb-4" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                            @(string.IsNullOrEmpty(item.Descricao) ? "Nenhuma observação informada." : item.Descricao)
                                        </p>
                                        <div class="d-flex flex-wrap gap-2 mb-4">
                                            <span class="animal-tag">@item.CorPelagem</span>
                                            <span class="animal-tag">@item.FaixaEtaria</span>
                                            <span class="animal-tag">@item.EstadoSaude</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            isFirst = false;
                        }
                    </div>

                    <button class="carousel-control-prev" type="button" data-bs-target="#dogCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon bg-dark rounded-circle p-3" aria-hidden="true"></span>
                        <span class="visually-hidden">Anterior</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#dogCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon bg-dark rounded-circle p-3" aria-hidden="true"></span>
                        <span class="visually-hidden">Próximo</span>
                    </button>
                </div>
            </div>
        </div>
    </section>

    <section id="section-tutores" class="container-fluid py-4 d-none">

        <div class="d-flex justify-content-between align-items-center mb-4 px-md-4 px-2">
            <h2 class="fw-bold mb-0" style="color: var(--primary-green-dark);">
                <i class="fa-solid fa-bullhorn text-danger me-2"></i> Pets Perdidos
            </h2>
        </div>

        <div class="tutores-grid px-md-4 px-2 pb-5">
            @* Filtramos na própria View os pets marcados como 'Perdido' (ou o status que você definir no BD) *@
            @foreach (var item in Model.Where(m => m.TipoOcorrencia == "Perdido"))
            {
                <div class="animal-card mx-auto shadow-lg" data-id="@item.IdOcorrencia">
                    <div class="animal-card-img-wrapper">
                        <img src="@(string.IsNullOrEmpty(item.FotoAnimal) ? "/images/placeholder-dog.png" : item.FotoAnimal)"
                             class="animal-card-img" alt="Foto do pet perdido" />

                        <div class="badge-desaparecido shadow-sm">
                            <i class="fa-solid fa-circle-exclamation fa-fade"></i> PROCURA-SE
                        </div>

                        <div class="animal-card-overlay text-start">
                            <h3 class="mb-1 fw-bold text-white">@(string.IsNullOrEmpty(item.CodigoCachorro) ? "Sem Nome" : item.CodigoCachorro)</h3>

                            <p class="mb-2 text-light" style="font-size: 0.9rem;">
                                <i class="fa-solid fa-phone text-warning"></i> Contato: @(item.Usuario?.Telefone ?? "Não informado")
                            </p>

                            <button class="btn-gerar-cartaz w-100" onclick="gerarCartazPdf(@item.IdOcorrencia)">
                                <i class="fa-solid fa-print"></i> Gerar Cartaz
                            </button>
                        </div>
                    </div>
                </div>
            }

            @* Fallback caso não tenha nenhum cachorro perdido no momento *@
            @if (!Model.Any(m => m.TipoOcorrencia == "Perdido"))
            {
                <div class="col-12 text-center text-muted py-5" style="grid-column: 1 / -1;">
                    <i class="fa-solid fa-check-circle fa-3x mb-3" style="color: var(--light-green);"></i>
                    <h5>Nenhum pet perdido registrado no momento.</h5>
                </div>
            }
        </div>
    </section>
    <div class="drawer-overlay" id="drawerOverlay" onclick="fecharPerfilAnimal()"></div>

    <aside class="right-sidebar dog-profile-sidebar" id="painel-detalhes" style="display: none;">

        <button class="btn-close-drawer" onclick="fecharPerfilAnimal()" title="Fechar perfil">
            <i class="fa-solid fa-times"></i>
        </button>

        <div class="profile-img-wrap" id="container-foto-sidebar">
            <img id="sidebar-foto" src="" alt="Cachorro" style="display:block; width:100%;" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
            <div class="aviso-sem-foto" style="display:none; flex-direction:column; align-items:center; justify-content:center; background:#eee; height:200px;">
                <i class="fa-solid fa-dog fa-3x text-secondary"></i>
                <p class="text-secondary mt-2">Imagem não encontrada</p>
            </div>
        </div>

        <div class="profile-header d-flex align-items-center justify-content-between">
            <h2 id="sidebar-titulo-id">ID do Cachorro</h2>
            <div class="header-actions d-flex align-items-center" id="header-acoes-ocorrencia" data-usuario-logado="@User.FindFirstValue(ClaimTypes.NameIdentifier)">
                <i class="fa-regular fa-pen-to-square edit-icon @(User.Identity != null && User.Identity.IsAuthenticated ? "" : "auth-required")" id="btn-editar-ocorrencia" style="cursor: pointer;" title="Editar Ocorrência"></i>
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <i class="fa-regular fa-trash-can delete-icon ms-3" id="btn-deletar-ocorrencia" style="cursor: pointer; color: var(--primary-orange); display: none;" title="Excluir Ocorrência"></i>
                }
            </div>
        </div>

        <form id="form-deletar-ocorrencia" asp-controller="Ocorrencias" asp-action="Delete" method="post" style="display:none;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="deletar-ocorrencia-id" value="" />
        </form>

        <hr class="profile-divider">

        <div class="profile-section">
            <h3 class="section-title">Status do Animal</h3>
            <div class="status-box">
                <div class="status-item"><span class="status-label">Sexo:</span><span class="status-data" id="sidebar-sexo">---</span></div>
                <div class="status-item"><span class="status-label">Cor:</span><span class="status-data" id="sidebar-cor">---</span></div>
                <div class="status-item"><span class="status-label">Porte:</span><span class="status-data" id="sidebar-porte">---</span></div>
                <div class="status-item"><span class="status-label">Estado de Saúde:</span><span class="status-data" id="sidebar-estadosaude">---</span></div>
                <div class="status-item"><span class="status-label">Faixa Etária:</span><span class="status-data" id="sidebar-idade">---</span></div>
            </div>
        </div>

        <div class="profile-section action-card-container">
            <h3 class="section-title">Registro de Ações</h3>
            <div class="action-layout">
                <div class="action-buttons-modern">
                    <button class="btn-modern btn-agua-modern" onclick="executarAcao('agua', this)"><i class="fa-solid fa-droplet"></i><span>Água</span></button>
                    <button class="btn-modern btn-comida-modern" onclick="executarAcao('comida', this)"><i class="fa-solid fa-bowl-food"></i><span>Comida</span></button>
                </div>
                <div class="user-status-card">
                    <div class="user-card-header">
                        <div class="user-card-info">
                            <span class="user-label">Último cuidador:<strong id="sidebar-user-id" class="text-primary">Nenhum</strong></span>
                        </div>
                    </div>
                    <div class="user-card-body">
                        <div class="status-row">
                            <i class="fa-solid fa-droplet icon-agua"></i>
                            <span class="status-label-text">Última Água:</span>
                            <strong id="sidebar-last-agua" class="status-value">--:--</strong>
                        </div>
                        <div class="status-row">
                            <i class="fa-solid fa-bowl-food icon-comida"></i>
                            <span class="status-label-text">Última Comida:</span>
                            <strong id="sidebar-last-comida" class="status-value">--:--</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <hr class="profile-divider">

        <div class="profile-section comments-section">
            <h3 class="section-title">Comentários:</h3>
            <form id="form-comentario-sidebar" asp-controller="Comentarios" asp-action="Create" method="post" class="comment-input-row">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idOcorrencia" id="comentario-id-ocorrencia" />
                <input type="text" name="texto" class="comment-input" placeholder="Adicionar comentário..." required>
                <button type="submit" class="btn-send-comment" title="Enviar"><i class="fa-solid fa-paper-plane"></i></button>
            </form>
            <div class="comments-list" id="comentarios-container">
                <p class="text-muted">Ainda não há nenhum comentário.</p>
            </div>
        </div>
    </aside>

    <div id="editModalContainer"></div>
</main>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/map-handler.js" asp-append-version="true"></script>
    <script src="~/js/dog-api-handler.js" asp-append-version="true"></script>
    <script src="~/js/ocorrencias.js" asp-append-version="true"></script>
    <script src="~/js/filtro-mapa.js" asp-append-version="true"></script>
    <script src="~/js/geradorCartaz.js" asp-append-version="true"></script>
    <script src="~/js/favoritos.js" asp-append-version="true"></script>


}
