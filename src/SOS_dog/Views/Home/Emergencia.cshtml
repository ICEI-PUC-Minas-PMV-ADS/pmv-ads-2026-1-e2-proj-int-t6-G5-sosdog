@{
    ViewData["Title"] = "Contatos de Emergência";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<style>
    /* CSS Isolado e Blindado para a Tela de Emergência */
    #sosdog-emergencia {
        background-color: #f2f2f2 !important;
        width: 100% !important;
        min-height: calc(100vh - 120px) !important;
        display: flex !important;
        justify-content: center !important;
        align-items: center !important;
        padding: 40px 20px !important;
        box-sizing: border-box !important;
    }

    #sosdog-emergencia .container-emergencia {
        background-color: #2b443b !important;
        width: 100% !important;
        max-width: 650px !important;
        padding: 40px 35px !important;
        border-radius: 15px !important;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25) !important;
        text-align: center !important;
        margin: auto !important;
    }

    #sosdog-emergencia .header-emergencia i {
        font-size: 3.5rem !important;
        color: #e57357 !important;
        margin-bottom: 20px !important;
        display: inline-block !important;
    }

    #sosdog-emergencia .container-emergencia h1 {
        font-size: 2rem !important;
        font-weight: 700 !important;
        margin-bottom: 12px !important;
        color: #ffffff !important;
    }

    #sosdog-emergencia .container-emergencia p {
        font-size: 0.95rem !important;
        color: #cbd5e1 !important;
        margin-bottom: 35px !important;
        line-height: 1.6 !important;
    }

    #sosdog-emergencia .lista-contatos {
        display: flex !important;
        flex-direction: column !important;
        gap: 16px !important;
        margin-bottom: 35px !important;
        padding: 0 !important;
    }

    #sosdog-emergencia .card-contato {
        background-color: #1f322b !important;
        border-left: 4px solid #e57357 !important;
        padding: 18px 22px !important;
        border-radius: 10px !important;
        display: flex !important;
        justify-content: space-between !important;
        align-items: center !important;
        text-align: left !important;
        transition: transform 0.2s, background-color 0.2s !important;
        text-decoration: none !important;
    }

    #sosdog-emergencia .card-contato:hover {
        transform: translateY(-2px) !important;
        background-color: #253b33 !important;
    }

    #sosdog-emergencia .info-contato h3 {
        font-size: 1.15rem !important;
        font-weight: 600 !important;
        color: #ffffff !important;
        margin-bottom: 4px !important;
    }

    #sosdog-emergencia .info-contato p {
        margin-bottom: 0 !important;
        font-size: 0.88rem !important;
        color: #a3b8cc !important;
        line-height: 1.4 !important;
    }

    #sosdog-emergencia .btn-ligar {
        background-color: #e57357 !important;
        color: white !important;
        text-decoration: none !important;
        padding: 12px 20px !important;
        border-radius: 8px !important;
        font-weight: 700 !important;
        font-size: 1rem !important;
        display: flex !important;
        align-items: center !important;
        gap: 8px !important;
        transition: background-color 0.2s !important;
    }

    #sosdog-emergencia .btn-ligar:hover {
        background-color: #cf5f44 !important;
    }

    #sosdog-emergencia .btn-voltar {
        display: inline-flex !important;
        align-items: center !important;
        gap: 8px !important;
        color: #cbd5e1 !important;
        text-decoration: none !important;
        font-size: 0.95rem !important;
        font-weight: 600 !important;
        transition: color 0.2s !important;
        margin-top: 15px !important;
    }

    #sosdog-emergencia .btn-voltar:hover {
        color: #e57357 !important;
    }
</style>

<div id="sosdog-emergencia">
    <div class="container-emergencia">

        <div class="header-emergencia">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <h1>Contatos de Emergência</h1>
        </div>

        <p>Se você presenciou um caso de maus-tratos extremes, acidente grave ou risco iminente à vida de um animal, entre em contato com as autoridades pelos canais abaixo.</p>

        <div class="lista-contatos">

            <div class="card-contato">
                <div class="info-contato">
                    <h3>Polícia Militar (Flagrantes)</h3>
                    <p>Para casos de agressão ou abandono acontecendo agora.</p>
                </div>
                <a href="#" class="btn-ligar" data-numero="190">
                    <i class="fa-solid fa-copy"></i> Copiar 190
                </a>
            </div>

            <div class="card-contato">
                <div class="info-contato">
                    <h3>Corpo de Bombeiros (Resgate)</h3>
                    <p>Para animais presos, em locais de risco ou atropelados.</p>
                </div>
                <a href="#" class="btn-ligar" data-numero="193">
                    <i class="fa-solid fa-copy"></i> Copiar 193
                </a>
            </div>

            <div class="card-contato">
                <div class="info-contato">
                    <h3>Disque Denúncia / Polícia Civil</h3>
                    <p>Para registrar denúncias anônimas e investigações.</p>
                </div>
                <a href="#" class="btn-ligar" data-numero="181">
                    <i class="fa-solid fa-copy"></i> Copiar 181
                </a>
            </div>

        </div>

        <a href="/Home/Index" class="btn-voltar">
            <i class="fa-solid fa-arrow-left"></i> Voltar para o Início
        </a>

    </div>
</div>

@section Scripts {
    <script src="~/js/emergencia.js" asp-append-version="true"></script>
}