@* @model IEnumerable<SosDog.Models.Ocorrencia>

@{
    ViewData["Title"] = "Feed de Casos";
}

<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css" />
<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css" />

<style>
    body { background-color: #d1d5d1; } /* Fundo acinzentado do Figma */
    
    .feed-wrapper { display: flex; gap: 20px; padding: 20px; margin-top: 20px; }

    /* Barra Lateral Esquerda */
    .sidebar-list { width: 350px; display: flex; flex-direction: column; gap: 10px; }
    .mini-card { 
        background: #f8f9f8; border: 1px solid #9ba59b; border-radius: 15px; 
        padding: 10px; display: flex; align-items: center; gap: 15px; 
    }
    .mini-card img { width: 60px; height: 60px; border-radius: 50%; object-fit: cover; border: 2px solid #5d705d; }
    .mini-info h6 { margin: 0; font-size: 14px; color: #333; }
    .mini-info p { margin: 0; font-size: 11px; color: #666; }

    /* Área do Carrossel à Direita */
    .carousel-section { flex: 1; background: #9ba59b; border-radius: 20px; padding: 30px; position: relative; }
    .badge-top { background: #4a5a4a; color: white; padding: 5px 15px; border-radius: 20px; position: absolute; top: 15px; left: 20px; }

    .main-card { background: #e0e4e0; border-radius: 20px; padding: 20px; margin: 0 10px; min-height: 450px; text-align: center; }
    .main-card img { width: 100%; height: 200px; object-fit: cover; border-radius: 15px; margin-bottom: 15px; }
    
    .tags { display: flex; flex-wrap: wrap; justify-content: center; gap: 5px; margin: 10px 0; }
    .tag { background: #8fa08f; color: #2d382d; padding: 3px 10px; border-radius: 5px; font-size: 12px; font-weight: bold; }
    
    .card-actions { display: flex; justify-content: center; gap: 20px; margin-top: 20px; font-size: 20px; color: #4a5a4a; }
    
    /* Botões flutuantes inferiores */
    .bottom-actions { display: flex; gap: 10px; margin-top: 20px; }
    .btn-urgent { background: #c67a6b; color: white; border: none; padding: 10px 20px; border-radius: 10px; }
    .btn-report { background: #c68a6b; color: white; border: none; padding: 10px 20px; border-radius: 10px; }
</style>

<div class="container-fluid">
    <div class="feed-wrapper">
        
        <div class="sidebar-list">
            @foreach (var item in Model.Take(5)) {
                <div class="mini-card">
                    <img src="@(string.IsNullOrEmpty(item.FotoAnimal) ? "/images/placeholder-dog.png" : item.FotoAnimal)" />
                    <div class="mini-info">
                        <h6>Id: @item.IdOcorrencia</h6>
                        <p><strong>Local:</strong> @item.Endereco</p>
                        <p>Status: @item.EstadoSaude</p>
                    </div>
                </div>
            }
        </div>

        <div class="carousel-section">
            <div class="badge-top">feed de notícias</div>
            
            <div class="main-carousel">
                @foreach (var item in Model) {
                    <div class="main-card">
                        <img src="@(string.IsNullOrEmpty(item.FotoAnimal) ? "/images/placeholder-dog.png" : item.FotoAnimal)" />
                        <h5>ID do animal</h5>
                        
                        <div class="tags">
                            <span class="tag">@item.Sexo</span>
                            <span class="tag">@item.Porte</span>
                            <span class="tag">@item.CorPelagem</span>
                            <span class="tag">@item.FaixaEtaria</span>
                        </div>

                        <p class="mt-3"><strong>Observações:</strong><br>@item.Descricao</p>

                        <div class="card-actions">
                            <i class="fas fa-share-alt"></i>
                            <i class="far fa-heart"></i>
                            <i class="far fa-bookmark"></i>
                        </div>
                    </div>
                }
            </div>

            <div class="bottom-actions" style="display: flex; gap: 10px; width: 100%;">
                <a asp-controller="Home" asp-action="Emergencia" style="text-decoration: none; flex: 1; display: block;">
                    <button type="button" class="btn-urgent" style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; gap: 8px; margin: 0;">
                        <i class="fas fa-users"></i> Urgente
                    </button>
                </a>

                <button type="button" class="btn-report" style="flex: 1; display: flex; align-items: center; justify-content: center; gap: 8px;">
                    <i class="fas fa-edit"></i> Reportar Animal
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
    <script>
        $(document).ready(function(){
            $('.main-carousel').slick({
                infinite: true,
                slidesToShow: 3,
                slidesToScroll: 1,
                prevArrow: '<button type="button" class="slick-prev" style="left:-30px">←</button>',
                nextArrow: '<button type="button" class="slick-next" style="right:-30px">→</button>',
                responsive: [
                    { breakpoint: 1200, settings: { slidesToShow: 2 } },
                    { breakpoint: 768, settings: { slidesToShow: 1 } }
                ]
            });
        });
    </script>
} *@